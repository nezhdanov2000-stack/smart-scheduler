# Copy to .env and fill in. Never commit .env.
# This file stays on your machine. On first start the keys below are imported into n8n's
# encrypted credential vault (the workflows never read .env).

# Public HTTPS URL for Telegram webhooks. start.ps1 fills this in automatically from the
# Cloudflare quick tunnel; set it by hand only if you have a fixed URL.
WEBHOOK_URL=

TIMEZONE=Asia/Bangkok

# Generate with:  openssl rand -hex 32   (or any 64 random hex chars)
# Keep it safe: it decrypts the credential vault. Never change it after the first run.
N8N_ENCRYPTION_KEY=CHANGE_ME

OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Google Cloud OAuth client (type "Web application"), redirect URI:
#   http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
