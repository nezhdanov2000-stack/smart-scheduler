# Copy to .env and fill in.  Never commit .env.
# This file stays on your machine. On first start the keys below are imported into n8n's
# encrypted credential vault; you can also add them by hand in the n8n UI instead.

# Public HTTPS URL for Telegram webhooks. start.ps1 / start.sh fill this in automatically
# from the Cloudflare quick tunnel; set it by hand only if you have a fixed URL.
WEBHOOK_URL=

# Generate with:  openssl rand -hex 32     (keep it safe: it decrypts the vault)
N8N_ENCRYPTION_KEY=CHANGE_ME

TIMEZONE=Asia/Bangkok
N8N_VERSION=latest
WORKER_CONCURRENCY=5

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Used by evaluation/evaluate.py, and by the first-run bootstrap, which imports these into
# n8n's encrypted credential vault (the workflows never read .env).
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Google Cloud OAuth client (type "Web application"), redirect URI:
#   http://localhost:5678/rest/oauth2-credential/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
